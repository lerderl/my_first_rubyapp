<h1>Hello, Arinze!</h1>
<p>Find me at LCC.</p>

<% a = 1 %> <%# Variable declaration and initilaization %>
<%= a + 100 %> <%# Operation using variable %>

<%# Loops %>
<% 1.upto(100) do |i| %>
  <%# If-Else %>
  <% if i % 2 == 1 %>
    <h6>
      <%= i %>
    </h6>
  <% else %>
    <h2>
      <%= i %>
    </h2>
  <% end %>
<% end %>
